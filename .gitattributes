# Enforce line endings per file class.
# Windows-side scripts MUST be CRLF and ASCII: cmd.exe and the dockur
# image's batch normaliser both choke on LF-only .bat files.
* text=auto eol=lf

*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.reg   text eol=crlf

*.sh    text eol=lf
*.py    text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf

*.png   binary
*.iso   binary
*.exe   binary
